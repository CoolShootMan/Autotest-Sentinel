# =============================================================================
# backend/.env.example — 复制成 backend/.env 后填入自己的凭证
# =============================================================================
#   Mac/Linux :  cp backend/.env.example backend/.env
#   Windows   :  copy backend\.env.example backend\.env
#
# ⚠️ backend/.env 已被 .gitignore 忽略（规则 `.env`，第 37 行）。**不要把真实 token 提交进仓库。**
#
# 分两类：
#   [团队常量] 所有人一样，照抄即可
#   [个人凭证] 每人自己申请，不要互相借用（否则操作审计会算到别人头上）
# =============================================================================

# ----------------------------------------------------------------------------
# [团队常量] 照抄，不用改
# ----------------------------------------------------------------------------
JIRA_BASE_URL=https://pearshop.atlassian.net
ONES_URL=https://sz.ones.cn
ONES_ORG_UUID=ATfPf79v
ONES_TEAM_UUID=T7u1zXum
ONES_LIBRARY_UUID=XcAFFViB

# ONES 的优先级 / 类型 UUID（建用例时用，见 skill jira-ones-testflow）
ONES_PRIORITY_HIGHEST=3g7bLpa1
ONES_PRIORITY_HIGH=VRXHXgbp
ONES_PRIORITY_NORMAL=JoEcqaCe
ONES_PRIORITY_LOW=R7wMSiP3
ONES_PRIORITY_LOWEST=3DvJC11V
ONES_TYPE_FUNCTIONAL=7qLS7W5f

# ----------------------------------------------------------------------------
# [个人凭证] 换成你自己的
# ----------------------------------------------------------------------------

# Jira：Atlassian → 头像 → Account settings → Security → API tokens → Create API token
JIRA_EMAIL=your.name@company.com
JIRA_API_TOKEN=REPLACE_WITH_YOUR_JIRA_API_TOKEN

# ONES：登录邮箱 + 密码（用来自动换 ONES_AUTH_TOKEN）
ONES_EMAIL=your.name@company.com
ONES_PASSWORD=REPLACE_WITH_YOUR_ONES_PASSWORD

# Figma：头像 → Settings → Personal access tokens → Generate new token
#   权限只要 file_content:read + file_metadata:read（见 skill jira-ones-browser-verify Phase 1.5）
FIGMA_TOKEN=REPLACE_WITH_YOUR_FIGMA_TOKEN

# ----------------------------------------------------------------------------
# [自动生成] 不要手填
# ----------------------------------------------------------------------------
# ONES_AUTH_TOKEN 由 `py -3.9 tools/ones_writer.py refresh-token` 登录后自动写入（约 1 小时过期）
# ONES_USER_ID    同样在首次 refresh-token 后从登录响应里读回填
ONES_AUTH_TOKEN=
ONES_USER_ID=

# ----------------------------------------------------------------------------
# [可选] AI 诊断（tools/diagnose_failed.py / step_analyzer.py 用）
#   不填也能跑：这两个脚本会跳过 AI 建议，只输出 RAG/规则诊断。
#   多个 key 用英文逗号分隔，脚本会按顺序做模型降级链。
# ----------------------------------------------------------------------------
GEMINI_API_KEYS=
