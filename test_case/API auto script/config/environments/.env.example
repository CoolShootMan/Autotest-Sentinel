# =============================================================================
#  Apifox test secret .env.example
# =============================================================================
# Copy this file to .env (or config/environments/.env) and fill in real values.
# The pytest harness auto-loads .env via python-dotenv (best-effort, not required).
# If python-dotenv is not installed, you can `export` each var in your shell.
#
# Variables below are referenced by config/environments/*.yaml via {{NAME}}.
# Empty strings are NOT accepted — every line marked [required] must be set
# before running the corresponding env (Release / Staging / Production / Local).
# =============================================================================

# ---- [required for Release] -----
# LIVE JWT for the main Release test account. Format: Bearer <jwt>
# (the YAML template prepends "Bearer " — paste ONLY the raw JWT)
RELEASE_TOKEN=

# MD5 hash used by Release merchant login.
MERCHANT_PASSWORD=

# MD5 hash used by the P1 test persona login (Release only).
P1_PASSWORD=

# Plaintext password for the admin UI on Release (used by web_ui_test).
ADMIN_PASSWORD=

# ---- [required for all envs] -----
# PostgreSQL password for the Release DB host (katana-release.ctv4lcp038zi.us-east-2.rds.amazonaws.com).
# DB user is fixed to postgres, db name is katana, host is in Global.yaml.template.
RELEASE_SQL_PASSWORD=

# OAuth2 client secret for ALL envs (Pear OAuth flow is the same across release/staging/production).
PEAR_CLIENT_SECRET=

# ---- [required for non-Release] -----
# Staging JWT for the staging test account (Borneo).
STAGING_TOKEN=

# Staging admin UI password (used by web_ui_test in Staging).
# Same person as ADMIN_PASSWORD? Defaults from yaml suggest yes, but can diverge.
# Leave blank if not used.

# Production JWT (for Production env).
PRODUCTION_TOKEN=

# Production admin UI password.
# Leave blank if not used.

# Local token (mock server).
LOCAL_TOKEN=

# ---- [optional] -----
# Global token (shared across all envs; used as fallback for cross-env tests).
GLOBAL_TOKEN=
